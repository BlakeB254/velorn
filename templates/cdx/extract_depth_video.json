{
  "1": {"class_type": "LoadVideo", "inputs": {"file": "{{VIDEO}}"}},
  "2": {"class_type": "GetVideoComponents", "inputs": {"video": ["1", 0]}},
  "3": {"class_type": "LoadVideoDepthAnythingModel", "inputs": {"model": "{{MODEL}}"}},
  "4": {"class_type": "VideoDepthAnythingProcess", "inputs": {
    "vda_model": ["3", 0],
    "images": ["2", 0],
    "input_size": 518,
    "max_res": 1280,
    "precision": "fp16"
  }},
  "5": {"class_type": "VideoDepthAnythingOutput", "inputs": {"depths": ["4", 0], "colormap": "gray"}},
  "6": {"class_type": "CreateVideo", "inputs": {"images": ["5", 0], "fps": ["2", 2]}},
  "7": {"class_type": "SaveVideo", "inputs": {
    "video": ["6", 0],
    "filename_prefix": "{{PREFIX}}",
    "format": "mp4",
    "codec": "h264"
  }}
}
