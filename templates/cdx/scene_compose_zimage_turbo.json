{
  "1": {
    "inputs": {"unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default"},
    "class_type": "UNETLoader",
    "_meta": {"title": "Z-Image Turbo UNET"}
  },
  "2": {
    "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default"},
    "class_type": "CLIPLoader",
    "_meta": {"title": "Qwen 3 4B (lumina2 type)"}
  },
  "3": {
    "inputs": {"vae_name": "ae.safetensors"},
    "class_type": "VAELoader",
    "_meta": {"title": "Flux AE VAE"}
  },
  "4": {
    "inputs": {"text": "{{PROMPT}}", "clip": ["2", 0]},
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"}
  },
  "5": {
    "inputs": {"conditioning": ["4", 0]},
    "class_type": "ConditioningZeroOut",
    "_meta": {"title": "Empty Negative"}
  },
  "6": {
    "inputs": {"width": 1024, "height": 576, "batch_size": 1},
    "class_type": "EmptySD3LatentImage",
    "_meta": {"title": "Empty 1024x576 (16:9)"}
  },
  "7": {
    "inputs": {"model": ["1", 0], "shift": 3.0},
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {"title": "Aura Flow Sampling"}
  },
  "8": {
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["7", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0]
    },
    "class_type": "KSampler",
    "_meta": {"title": "K Sampler (8 steps turbo)"}
  },
  "9": {
    "inputs": {"samples": ["8", 0], "vae": ["3", 0]},
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"}
  },
  "10": {
    "inputs": {"filename_prefix": "scene_compose", "images": ["9", 0]},
    "class_type": "SaveImage",
    "_meta": {"title": "Save Composed First Frame"}
  }
}
